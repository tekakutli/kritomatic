{
  "1":  { "class_type": "ETN_KritaCanvas", "inputs": {} },
  "2":  {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model":             ["5", 0],
      "image":             ["1", 0],
      "conditioning":      ["6", 0],
      "positive_coords":   ["7", 0],
      "negative_coords":   ["8", 0],
      "threshold":         ["9", 0],
      "refine_iterations": ["10", 0],
      "individual_masks":  ["11", 0]
    }
  },
  "3":  { "class_type": "MaskToImage",     "inputs": { "mask":   ["2", 0] } },
  "4":  { "class_type": "ETN_KritaOutput", "inputs": { "name": "mask", "images": ["3", 0] } },
  "5":  { "class_type": "CheckpointLoaderSimple",
          "inputs": { "ckpt_name": "segmentation/sam3.1_multiplex_fp16.safetensors" } },
  "6":  { "class_type": "CLIPTextEncode",
          "inputs": { "text": ["12", 0], "clip": ["5", 1] } },
  "7":  { "class_type": "ETN_Parameter",
          "inputs": { "name": "positive_coords",   "type": "text",   "default": "[]" } },
  "8":  { "class_type": "ETN_Parameter",
          "inputs": { "name": "negative_coords",   "type": "text",   "default": "[]" } },
  "9":  { "class_type": "ETN_Parameter",
          "inputs": { "name": "threshold",         "type": "number", "default": 0.5 } },
  "10": { "class_type": "ETN_Parameter",
          "inputs": { "name": "refine_iterations", "type": "number (integer)", "default": 2 } },
  "11": { "class_type": "ETN_Parameter",
          "inputs": { "name": "individual_masks",  "type": "toggle", "default": true } },
  "12": { "class_type": "ETN_Parameter",
          "inputs": { "name": "segment_text",      "type": "text",
                      "default": "woman, hair, eyes, legs, " } }
}
